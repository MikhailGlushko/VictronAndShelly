  {
    "id": "init_devices_func",
    "type": "function",
    "z": "d9d8e679810906eb",
    "name": "Init flow.devices & defaults",
    "func": "// Initialize devices list and default per-device flow variables\n// Devices configured here (id == DeviceInstance):\n// S0 (50) - S0-Зарядка на кухні\n// S1 (51) - S1-Зарядка Коридор\n// O1 (65) - O1-Зарядка Балкон\n// S3 (57) - S3-Зарядка спальня\n\nconst devices = [
  { id: 50, name: 'S0', tag: 'S0-Зарядка на кухні' },
  { id: 51, name: 'S1', tag: 'S1-Зарядка Коридор' },
  { id: 65, name: 'O1', tag: 'O1-Зарядка Балкон' },
  { id: 57, name: 'S3', tag: 'S3-Зарядка спальня' }
];

flow.set('devices', devices);

// Set sane defaults for per-device variables (only if not already set)
devices.forEach(d => {
  if (flow.get('state_' + d.id) === undefined) flow.set('state_' + d.id, 0);
  if (flow.get('s_mode_' + d.id) === undefined) flow.set('s_mode_' + d.id, 1); // auto enabled
  if (flow.get('power_' + d.id) === undefined) flow.set('power_' + d.id, 0);
  if (flow.get('voltage_' + d.id) === undefined) flow.set('voltage_' + d.id, 230);
});

// global defaults used by priority logic
if (context.get('ess_state') === undefined) context.set('ess_state', global.get('ess_state') || -1);

return null;",
    "outputs": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 80,
    "wires": []
