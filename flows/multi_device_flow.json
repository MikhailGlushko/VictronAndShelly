  {
    "id": "priority_logic_func",
    "type": "function",
    "z": "d9d8e679810906eb",
    "name": "Priority Logic (multi-device)",
    "func": "// Multi-device priority logic\n// Returns N outputs (one per device) + last output for Telegram messages\n\n// --- 0. Kyiv time ---\nconst kyivTime = new Date().toLocaleString(\"en-US\", {timeZone: \"Europe/Kyiv\", hourCycle: \"h23\"});\nconst d = new Date(kyivTime);\nconst hours = d.getHours();\nconst minutes = d.getMinutes();\nconst totalMinutes = hours * 60 + minutes;\n\n// schedule bounds\nconst s_start_h = 23;\nconst s_start_m = 10;\nconst s_end_h = 6;\nconst s_end_m = 50;\n\n// ESS modes\nconst ess_state = context.get('ess_state') ?? global.get('ess_state');\nconst essMode9 = 9;\nconst essMode10 = 10;\n\nconst i_mode = global.get('mode'); // 1-Charger,2-Inverter,3-On,4-Off\nconst inputAvailable = (global.get('input') === 0); // true if grid present\n\n// get devices\nconst devices = flow.get('devices') || [];
// Ensure function outputs count matches devices.length + 1
// Node-RED will ignore extra elements when returned, but it's good practice.

let telegramMsgs = [];
let outputs = [];

devices.forEach(dev => {
  const stateKey = 'state_' + dev.id;
  const sModeKey = 's_mode_' + dev.id;
  const deviceState = flow.get(stateKey) !== undefined ? flow.get(stateKey) : flow.get('s_state');
  const deviceAutoMode = flow.get(sModeKey) !== undefined ? flow.get(sModeKey) : flow.get('s_mode');
  const stateBool = (deviceState === 1);
  const s_mode_enabled = !!deviceAutoMode;

  const allow = (ess_state === essMode9) ||
                (totalMinutes >= s_start_h*60 + s_start_m && totalMinutes <= 24*60) ||
                (totalMinutes <= s_end_h*60 + s_end_m && totalMinutes >= 0);

  const allowState = ((i_mode == 3) && inputAvailable && allow);

  let cmdMsg = null;
  if (s_mode_enabled && stateBool !== allowState) {
    cmdMsg = { payload: (allowState ? 1 : 0) };
    // metadata
    cmdMsg.deviceId = dev.id;
    cmdMsg.deviceName = dev.name;
    cmdMsg.topic = `switch/${dev.id}`;

    const mode_state = (i_mode==1)?"Charger":((i_mode==2)?"Inverter":((i_mode==3)?"ON":"OFF"));
    const reason = `[${mode_state}] Grid [${inputAvailable ? '✅' : '❌'}] Charge [${allowState ? '✅' : '❌'}]`;
    const statusText = (allowState ? "\n🟢" : "\n🔴") + dev.tag + " (" + dev.id + ") " + reason;
    telegramMsgs.push({ payload: { chatId: 229352900, type: "message", content: statusText } });
  }
  outputs.push(cmdMsg);
});

// last output = telegram messages (array) or null
outputs.push( telegramMsgs.length ? telegramMsgs : null );

// update Node status (aggregate simple status)
let anyOn = devices.some(d => flow.get('state_' + d.id) === 1);
node.status({ fill: anyOn ? 'green' : 'red', shape: 'dot', text: `Devices: ${devices.length} - Any ON: ${anyOn}` });

return outputs;",
    "outputs": 5,
    "noerr": 0,
    "initialize": "// Set defaults used inside the function if needed\ncontext.set('ess_state', context.get('ess_state') || global.get('ess_state') || -1);",
