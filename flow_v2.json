    {
        "id": "calc_kpd",
        "type": "function",
        "z": "94965d902f34224f",
        "name": "КПД (robust)",
        "func": "// Robust KPI calculation, uses flow context to store latest inputs\nconst topic = (msg.topic || '').toString().trim();\nconst payload = Number(msg.payload);\nif (!Number.isFinite(payload)) return null;\n\n// Update flow-stored inputs (only accept non-negative for certain topics as before)\nif (topic === 'acPowerIn') {\n    if (payload >= 0) flow.set('acPowerIn', payload);\n} else if (topic === 'acPowerOut') {\n    if (payload >= 0) flow.set('acPowerOut', payload);\n} else if (topic === 'dcPower') {\n    flow.set('dcPower', payload);\n} else {\n    return null; // unknown topic\n}\n\nconst acPowerIn  = Number(flow.get('acPowerIn') ?? 0);\nconst acPowerOut = Number(flow.get('acPowerOut') ?? 0);\nconst dcPower    = Number(flow.get('dcPower') ?? 0);\n\n// safety\nconst eps = 1e-6;\nlet losses = acPowerIn - acPowerOut - dcPower;\nif (!Number.isFinite(losses)) losses = 0;\nif (losses < 0) losses = 0;\n\nconst power2 = Math.max(0, acPowerIn - dcPower);\n\nif (acPowerIn <= eps) {\n    node.status({fill:\"grey\",shape:\"ring\",text:\"no AC input\"});\n    return null; // nothing meaningful to compute\n}\n\nlet kpd;\nif (dcPower >= 0) {\n    kpd = 100 - (losses * 100) / acPowerIn;\n} else {\n    const denom = power2 > eps ? power2 : acPowerIn;\n    kpd = 100 - (losses * 100) / denom;\n}\nif (!Number.isFinite(kpd)) return null;\nkpd = Math.round(kpd * 100) / 100; // 2 decimals\n\n// drop unrealistic values\nif (kpd >= 100 || kpd < -50) {\n    node.status({fill:\"yellow\",shape:\"dot\",text:`out-of-range ${kpd}%`});\n    return null;\n}\n\n// suppress small changes (threshold 0.1%)\nconst last = flow.get('lastKpd');\nif (last !== undefined && Math.abs(last - kpd) < 0.1) {\n    node.status({fill:\"blue\",shape:\"dot\",text:`КПД: ${kpd}% (no change)`});\n    return null;\n}\nflow.set('lastKpd', kpd);\n\n// Build outgoing message for Shelly: set shellyId and numeric payload\nmsg.shellyId = 201; // Shelly Number component for inverter KPD\nmsg.payload = kpd;\nnode.status({fill:\"blue\",shape:\"dot\",text:`КПД: ${kpd}% (${Math.round(-losses)}W)`});\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 640,
        "y": 480,
        "wires": [
            [
                "shelly_prep"
            ]
        ]
    },
    {
