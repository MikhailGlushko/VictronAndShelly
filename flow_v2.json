    {
        "id": "shelly_prep",
        "type": "function",
        "z": "94965d902f34224f",
        "name": "Shelly Number.Set – prepare + dedup",
        "func": "// Generic Shelly Number.Set prep with per-id dedup thresholds\nconst id = Number(msg.shellyId ?? (msg.payload && msg.payload.id));\nlet value = (typeof msg.payload === 'object' && msg.payload !== null && msg.payload.value !== undefined)\n            ? Number(msg.payload.value)\n            : Number(msg.payload);\nif (!Number.isFinite(id) || !Number.isFinite(value)) return null;\n\n// per-id epsilon (tunable)\nlet eps = 0.5; // default 0.5 units\nif (id === 201) eps = 0.1; // KPD: small threshold (percent)\nif (id === 202) eps = 1;   // Power: 1 W threshold\nif (id === 200) eps = 0.2; // SOC: 0.2%\n\nconst lastKey = 'shelly_last_' + id;\nconst last = flow.get(lastKey);\nif (last !== undefined && Math.abs(last - value) < eps) {\n    node.status({fill:\"grey\",shape:\"ring\",text:`id ${id} no-change ${value}`});\n    return null; // suppress small/no change\n}\nflow.set(lastKey, value);\n\nmsg.payload = { id: id, value: value };\nmsg.headers = { 'Content-Type': 'application/json' };\nnode.status({fill:\"green\",shape:\"dot\",text:`id ${id} → ${value}`});\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 1000,
        "y": 480,
        "wires": [
